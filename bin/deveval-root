#!/usr/bin/env bash
# 플러그인 설치 경로(절대경로)를 출력한다.
# 평가자는 자기 작업 폴더에서 이 플러그인을 쓰므로, 기준 문서(reference/)·템플릿의
# 절대경로가 필요하다. 스킬이 이 값을 얻어 서브에이전트에 전달한다.
#   예: REF="$(deveval-root)/reference/KOICA-평가지침-2024-다이제스트.md"
# 심볼릭 링크로 PATH에 올려도 플러그인 루트를 잃지 않도록 실제 위치를 따라간다.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
cd "$here/.." && pwd -P
